PORT=3000

# Use DATABASE_URL or the individual PG* settings below.
# DATABASE_URL=postgresql://username:password@localhost:5432/pspl_expense_vouchers
PGHOST=localhost
PGPORT=5432
PGDATABASE=pspl_expense_vouchers
PGUSER=your_postgres_username
PGPASSWORD=your_postgres_password

# Required for login. Replace with a long, random value and keep it private.
JWT_SECRET=replace_with_a_long_random_secret

# Optional development seed accounts. Set all values for each role before running npm run seed.
# These credentials are only inserted when the email does not already exist.
SEED_EMPLOYEE_NAME=Development Employee
SEED_EMPLOYEE_EMAIL=employee@example.test
SEED_EMPLOYEE_PASSWORD=change_this_local_password
SEED_DIRECTOR_NAME=Development Director
SEED_DIRECTOR_EMAIL=director@example.test
SEED_DIRECTOR_PASSWORD=change_this_local_password
SEED_ACCOUNTS_NAME=Development Accounts
SEED_ACCOUNTS_EMAIL=accounts@example.test
SEED_ACCOUNTS_PASSWORD=change_this_local_password
